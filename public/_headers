/*
  Cloudflare Workers Static Assets caches by path. Fingerprinted files under /assets
  are immutable; the derived photographs keep stable names so they are revalidated
  instead of cached forever, which means replacing a photograph in public/media/
  is visible to guests without changing any HTML.
*/
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
